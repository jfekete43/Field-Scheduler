# Copy to .env and fill in, or set these in your host's dashboard.
# .env is gitignored and is never committed.

NODE_ENV=production

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=3000

# Where the SQLite database and uploaded images live. On a host with a
# persistent disk, point this at the mounted volume (often /data).
DATA_DIR=./data

# Number of reverse proxies in front of the app.
TRUST_PROXY_HOPS=1
